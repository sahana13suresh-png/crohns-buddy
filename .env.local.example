# Optional AWS Bedrock API Key (Bearer Token).
# Omit on AWS hosting to use the Amplify/Lambda execution role.
# Generate for local use from: AWS Console > Amazon Bedrock > API keys
AWS_BEARER_TOKEN_BEDROCK=your_aws_bearer_token_here

# Optional: AWS Region (defaults to us-east-1)
AWS_REGION=us-east-1

# Optional: Override the default model (defaults to Claude Sonnet 4)
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Crohn's-only Bedrock guardrail. Configure both values together.
BEDROCK_GUARDRAIL_ID=6vwvhqpr4sj7
BEDROCK_GUARDRAIL_VERSION=3

# Account authentication. Passwords are submitted only for the requested
# account operation and are never persisted by the application.
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_AUTH_SELF_REGISTRATION_ENABLED=false
NEXT_PUBLIC_AUTH_PROVIDERS=
COGNITO_AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=your_public_app_client_id
COGNITO_DOMAIN=https://crohns-buddy-example.auth.us-east-1.amazoncognito.com
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:3000,https://www.crohns-buddy.com
AUTH_SOCIAL_PROVIDERS=
AUTH_SELF_REGISTRATION_ENABLED=false
LOGTO_APP_SECRET=

# Optional social login deployment parameters. Configure this OAuth redirect
# URI in Google, Facebook, Login with Amazon, and Sign in with Apple:
# https://crohns-buddy-853513360253.auth.us-east-1.amazoncognito.com/oauth2/idpresponse
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v21.0
AMAZON_OAUTH_CLIENT_ID=
AMAZON_OAUTH_CLIENT_SECRET=
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
ENABLE_SOCIAL_IDENTITY_PROVIDERS=false

# Perspective API Key for content moderation
PERSPECTIVE_API_KEY=your_perspective_api_key_here

# Meal Plan Store (DynamoDB) — server-side only, never NEXT_PUBLIC_
MEAL_PLAN_TABLE_NAME=crohns-buddy-meal-plans
MEAL_PLAN_AWS_REGION=us-east-1
# Optional outside AWS. Omit both on AWS hosting to use the execution role.
MEAL_PLAN_AWS_ACCESS_KEY_ID=your_scoped_access_key_id
MEAL_PLAN_AWS_SECRET_ACCESS_KEY=your_scoped_secret_access_key

# Shared secret for the daily pending-deletion sweep
CRON_SECRET=generate_a_long_random_value
