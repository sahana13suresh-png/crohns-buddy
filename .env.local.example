# AWS Bedrock API Key (Bearer Token)
# Generate from: AWS Console > Amazon Bedrock > API keys
AWS_BEARER_TOKEN_BEDROCK=your_aws_bearer_token_here

# Optional: AWS Region (defaults to us-east-1)
AWS_REGION=us-east-1

# Optional: Override the default model (defaults to Claude Sonnet 4)
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Firebase configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Perspective API Key for content moderation
PERSPECTIVE_API_KEY=your_perspective_api_key_here
